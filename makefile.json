{
    "phar": {
        "by": [
            "php -d phar.readonly=0 build-phar.php"
        ]
    },
    "build": {
        "depends": [
            "phar"
        ]
    },
    "install": {
        "depends": [
            "build"
        ],
        "by": [
            "php install.php"
        ]
    },
    "uninstall": {
        "by": [
            "php install.php --uninstall"
        ]
    },
    "test": {
        "by": [
            "php tests/run.php"
        ]
    },
    "clean": {
        "by": [
            "rm -f make.phar"
        ]
    }
}
